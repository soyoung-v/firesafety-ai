# LLM 진단 설명(POST /explain) 설정. 값이 없으면 기본적으로 비활성화되며, 그 상태에서도
# FastAPI 서비스 자체(/predict 포함)는 정상 기동/동작한다.

# true여야 /explain이 실제 LLM 호출을 시도한다. 기본값 false.
LLM_EXPLANATION_ENABLED=false

# 현재 지원: openai
LLM_PROVIDER=openai

# 비밀값 - 실제 키를 이 파일(.env.example)에 커밋하지 않는다. 로컬 .env(gitignore 대상)에만 채운다.
OPENAI_API_KEY=

# 미설정 시 기본값(gpt-4o-mini) 사용
OPENAI_MODEL=

# LLM 응답 타임아웃(초). 미설정 시 기본값(10) 사용
LLM_TIMEOUT_SECONDS=
