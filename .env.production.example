# 운영 .env.production 템플릿 (Phase 14).
# 실제 값은 이 파일이 아니라 EC2 서버의 ~/arcguard/.env.production에만 채운다. 여기엔 절대 실값을
# 넣지 않는다. docker-compose.yml(firesafety-be 레포)의 ai-service가 이 파일을 env_file로 읽는다.
#
# OPENAI_API_KEY는 이 컨테이너(ai-service)에만 존재한다 - React/Spring Boot/GitHub repo/
# Docker image layer 어디에도 포함되지 않는다.

# 공개 데모에서 실제 LLM 설명을 쓸 계획이면 서버의 실 .env.production에서만 true로 바꾼다
# (비용 통제 정책은 llm-explanation-spec.md 참고 - 사용자 요청 시 최초 1회 생성 + DB 캐시,
# 자동 호출 없음).
LLM_EXPLANATION_ENABLED=false

LLM_PROVIDER=openai

# 비밀값 - change-me. 실제 키는 서버 .env.production에만.
OPENAI_API_KEY=change-me

OPENAI_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=10
